{
  "$schema_version": 1,
  "server": {
    "bind": "127.0.0.1:8080",
    "handler_threads": 16,
    "max_body_size": 65536
  },
  "sqlite": {
    "path": "data/app.db",
    "pool_size": 16,
    "synchronous": "NORMAL",
    "busy_timeout_ms": 5000
  },
  "cache": {
    "nshards": 512,
    "default_ttl_s": 60,
    "max_value_bytes": 32768
  },
  "tls": {
    "enabled": true,
    "bind": "0.0.0.0:8443",
    "cert_path": "/etc/ssl/certs/z-server.crt",
    "key_path": "/etc/ssl/private/z-server.key",
    "alpn": ["http/1.1"],
    "min_version": "1.2",
    "max_conns": 256
  },
  "logging": {
    "level": "info"
  }
}

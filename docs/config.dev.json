{
  "$schema_version": 1,
  "server": {
    "bind": "127.0.0.1:8080",
    "handler_threads": 4,
    "max_body_size": 65536
  },
  "sqlite": {
    "path": "data/app.db",
    "pool_size": 4,
    "synchronous": "NORMAL",
    "busy_timeout_ms": 5000
  },
  "cache": {
    "nshards": 256,
    "default_ttl_s": 60,
    "max_value_bytes": 32768
  },
  "tls": {
    "enabled": false
  },
  "logging": {
    "level": "debug"
  }
}

{
  "$schema_version": 1,
  "server": {
    "bind": "127.0.0.1:8080",
    "handler_threads": 16
  },
  "sqlite": {
    "path": "data/app.db",
    "pool_size": 16,
    "synchronous": "NORMAL"
  },
  "tls": {
    "enabled": true,
    "bind": "127.0.0.1:8443",
    "cert_path": "server.crt",
    "key_path": "server.key",
    "max_conns": 1024
  }
}
